# Copiez vers `.env` à la racine, puis renseignez les secrets.
# Vite charge automatiquement `.env` (préfixe VITE_ requis).

# API Nest prod Quizz+
VITE_API_BASE_URL=https://api.quizzp.com/api/v1/backoffice

# Pour développer contre une API locale :
# VITE_API_BASE_URL=http://localhost:3000/api/v1/backoffice

# Clé API backend (header x-api-key) — même valeur que BACKOFFICE_API_KEY côté API
VITE_BACKOFFICE_API_KEY=

# Identifiants login UI backoffice
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

VITE_DEV_TOOLS=true
